# App
APP_NAME=CareCircle
ENVIRONMENT=development
DEBUG=false

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>
# Transaction pooler URL (port 6543) — used by asyncpg at runtime
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET_DOCUMENTS=<bucket-names>
SUPABASE_STORAGE_BUCKET_CRISIS_PDFS=<bucket-names>
SUPABASE_STORAGE_BUCKET_MED_PDFS=<bucket-names>

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Gemini
GEMINI_API_KEY=<gemini-api-key>

# Firebase FCM
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# WhatsApp / Twilio
TWILIO_ACCOUNT_SID=<twilio-sid>
TWILIO_AUTH_TOKEN=<twilio-token>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Saravam (transcription)
SARAVAM_API_KEY=<saravam-key>
SARAVAM_API_URL=https://api.saravam.ai/v1/transcribe

# Frontend (used by backend for WhatsApp CTA deep links)
FRONTEND_BASE_URL=https://carecircle.app
# Dev override: FRONTEND_BASE_URL=http://localhost:3000
